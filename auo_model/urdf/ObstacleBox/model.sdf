<?xml version='1.0'?>
<sdf version='1.7'>
  <model name='ObstacleBox'>
    <static>false</static> 

    <link name='link'>
      <pose>0 0 0 0 0 0</pose> <kinematic>true</kinematic>
      <gravity>0</gravity>

      <collision name='collision'>
        <pose>0 0 0.3 0 0 0</pose> <geometry>
          <box>
            <size>0.4 0.4 0.4</size>
          </box>
        </geometry>
      </collision>

      <visual name='visual'>
        <pose>0 0 0.3 0 0 0</pose>
        <geometry>
          <box>
            <size>0.4 0.4 0.4</size> </box>
        </geometry>
        <material>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Orange</name>
          </script>
        </material>
      </visual>
    </link>
  </model>
</sdf>
